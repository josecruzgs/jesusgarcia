# ---------------------------------------------------------------------------
# ADSPOWER — perfiles y automatización
# ---------------------------------------------------------------------------
# AdsPower es una app de escritorio y su API solo escucha en el localhost de la
# máquina donde está instalada. Este valor apunta a esa API.
#
# EN PRODUCCIÓN AdsPower está instalado en el propio VPS, contra una pantalla
# virtual (ver sección 6 de DEPLOY.md), así que la dirección es local de verdad:
#
#     ADSPOWER_API_BASE_URL=http://127.0.0.1:50325
#
# En una máquina de escritorio con AdsPower abierto, el valor propio del cliente:
#
#     ADSPOWER_API_BASE_URL=http://local.adspower.net:50325
#
# ALTERNATIVA: AdsPower en una PC y la web en el servidor. Ahí el servidor no
# alcanza la API y hace falta un túnel inverso por SSH, que acerca ese puerto al
# localhost del servidor sin exponerlo a internet — queda atado al loopback:
#
#   ssh -N -o ServerAliveInterval=30 -o ExitOnForwardFailure=yes \
#       -R 50325:127.0.0.1:50325 burgueno@177.7.33.214
#
# La ventana se queda en blanco, sin prompt y sin dejar escribir: eso es que
# funciona. Al cerrarla, el servidor deja de ver AdsPower. Ojo: un túnel viejo
# olvidado le roba el puerto al AdsPower del propio servidor — si
# `sudo ss -tlnp | grep 50325` dice `sshd` en vez de `adspower_global`, es eso.
#
# COMPROBAR:
#   curl -s http://127.0.0.1:50325/status   → {"code":0,"msg":"success"}
#
# El túnel solo lo necesita lo que corre en el servidor web (sincronizar
# perfiles y grupos, iniciar/detener navegador). EJECUTAR tareas no: eso lo hace
# el worker `godeye-tasks`, que habla con AdsPower por su propio localhost.
ADSPOWER_API_BASE_URL=http://127.0.0.1:50325
# Solo si activaste "API key obligatoria" en AdsPower > Configuración > Avanzado
ADSPOWER_API_KEY=

# ---------------------------------------------------------------------------
# PANTALLA DEL SERVIDOR (/pantalla) — ver AdsPower trabajando en vivo
# ---------------------------------------------------------------------------
# AdsPower corre contra una pantalla virtual, y x11vnc + websockify la publican
# como noVNC (sección 6 de DEPLOY.md). El ícono de pantalla de la barra superior
# —solo para administradores— abre esa vista.
#
# EN PRODUCCIÓN esto se deja vacío: nginx sirve noVNC en /vnc/ del mismo
# dominio, con el chequeo de administrador delante, y el valor por defecto
# (/vnc/vnc.html?autoconnect=1&resize=scale&reconnect=1) ya apunta ahí.
#
# EN LOCAL no hay nginx. Se abre el túnel...
#
#   ssh -N -L 6080:127.0.0.1:6080 burgueno@177.7.33.214
#
# ...y se apunta acá, teniendo en cuenta que un panel servido por https no puede
# embeber un http (el navegador lo bloquea por contenido mixto):
#
#   VNC_URL=http://127.0.0.1:6080/vnc.html?autoconnect=1&resize=scale
#
# No es NEXT_PUBLIC_ a propósito: se lee en cada request, así que cambiarla solo
# pide reiniciar el server, no recompilar.
VNC_URL=

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/godeye

# Worker polling interval (ms)
WORKER_POLL_INTERVAL_MS=5000

# Qué mitad del worker enciende este proceso. La automatización necesita
# AdsPower en el mismo equipo; la escucha solo salida a internet. En producción
# corren los dos en el VPS como procesos separados (`godeye-tasks` y
# `godeye-listening` en ecosystem.config.cjs), cada uno con una de estas
# apagada. Separarlos permite además dejar solo la automatización en otra
# máquina si AdsPower vive ahí: se coordinan por Mongo, no entre sí.
# Vacías = las dos encendidas, que es lo correcto en local.
WORKER_TASKS=
WORKER_LISTENING=

# Dominio público donde vive el deploy accesible desde internet.
# Se usa SOLO para armar el texto del link en /campanas/compartir — si no
# está seteada, se arma con window.location.origin (ej. localhost cuando
# corres la app en tu máquina, que nadie más puede abrir).
# OJO: las NEXT_PUBLIC_ se inyectan en el build, no en el arranque. Cambiarla
# en el servidor no surte efecto hasta el próximo `npm run build`.
NEXT_PUBLIC_SHARE_BASE_URL=

# ---------------------------------------------------------------------------
# ESCUCHA (/scrapping) — monitoreo de menciones sobre figuras públicas
# ---------------------------------------------------------------------------
# Google News y GDELT no piden credencial: funcionan apenas creas el proyecto.
# Lo de abajo solo habilita fuentes adicionales.

# Análisis con IA: sentimiento, temas y resumen ejecutivo (Claude).
# Sin esta clave la ingesta sigue funcionando, pero las menciones quedan
# sin clasificar. Se saca de https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# YouTube Data API v3 — cuota diaria gratuita.
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Bright Data — la fuente de redes sociales (de pago, $1.50 por cada 1,000
# registros, con 5,000 gratis al mes). El token sale del panel de la cuenta;
# cada plataforma es un dataset distinto y necesita su propio id, que se
# copia de la página del scraper correspondiente en su marketplace.
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_DATASET_X=
BRIGHTDATA_DATASET_INSTAGRAM=
BRIGHTDATA_DATASET_TIKTOK=
BRIGHTDATA_DATASET_FACEBOOK=
BRIGHTDATA_DATASET_LINKEDIN=

# Clave con la que se firma la cookie de sesión. Todo el sitio queda detrás del
# login (excepto /share/[token], el dashboard público) — ver src/proxy.ts.
#
# OBLIGATORIA, también en local: sin ella el login falla con un error explícito.
# Que sea larga y aleatoria; quien la tenga puede fabricarse una sesión de
# cualquier usuario sin conocer ninguna contraseña. Generarla con:
#
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Cambiarla cierra todas las sesiones abiertas — que es justo lo que se quiere
# si sospechás que se filtró.
SESSION_SECRET=

# Los usuarios NO van acá: viven en Mongo y se administran desde /usuarios.
# El primero se crea por línea de comandos, que además adopta lo que ya existía:
#
#     npm run users:admin -- --username jose --password "una-larga"
